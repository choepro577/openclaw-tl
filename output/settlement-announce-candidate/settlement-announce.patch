+/**
+ * Resolve the child transcript through the session owner that lifecycle already
+ * loaded.  A complete internal transcript target is authoritative for recovery
+ * sessions; ordinary child runs reuse the exact owner row supplied by cleanup.
+ * Returning undefined keeps the existing capture fallback for callers that do
+ * not have a verified session identity.
+ */
+export const resolveSubagentSessionTranscriptTarget = (
+  params: Pick<SubagentLifecycleOptions, "getRuntimeConfig">,
+  entry: SubagentRunRecord,
+  options?: {
+    allowReadOnlyFallback?: boolean;
+    sessionEntry?: { sessionId?: string };
+  },
+): SessionTranscriptRuntimeTarget | undefined => {
+  const transcriptTarget = entry.execution.transcriptTarget;
+  const agentId = transcriptTarget?.agentId ?? resolveAgentIdFromSessionKey(entry.childSessionKey);
+  const sessionKey = transcriptTarget?.sessionKey ?? entry.childSessionKey;
+  const configuredStorePath =
+    transcriptTarget?.storePath ??
+    resolveSessionStorePathCore(params.getRuntimeConfig().session?.store, { agentId });
+  const storePath = resolveSessionStorePathForScope({
+    agentId,
+    sessionKey,
+    storePath: configuredStorePath,
+  });
+  const sessionId =
+    transcriptTarget?.sessionId ??
+    (transcriptTarget
+      ? loadSessionEntryReadOnly({ agentId, sessionKey, storePath })?.sessionId
+      : options?.sessionEntry?.sessionId ??
+        (options?.allowReadOnlyFallback
+          ? loadSessionEntryReadOnly({ agentId, sessionKey, storePath })?.sessionId
+          : undefined));
+  if (
+    !agentId.trim() ||
+    !sessionKey.trim() ||
+    !storePath.trim() ||
+    typeof sessionId !== "string" ||
+    !sessionId.trim()
+  ) {
+    return undefined;
+  }
+  return {
+    agentId,
+    sessionId: sessionId.trim(),
+    sessionKey,
+    storePath,
+  };
+};
