+};
+
+async function resolveRequesterDeliveryGatewayContext(params: {
+  requesterAgentId?: string;
+  resolveGatewayContext?: GatewayContextResolver;
+}): Promise<RequesterDeliveryContextResolution> {
+  const requesterAgentId = params.requesterAgentId?.trim();
+  // Shared and legacy requesters keep their existing resolver. There is no
+  // durable account owner for those keys, so guessing an Enterprise account
+  // here would widen the delivery authority after a restart.
+  if (!requesterAgentId?.startsWith("enterprise-personal-")) {
+    return { resolveGatewayContext: params.resolveGatewayContext };
+  }
+  const context = params.resolveGatewayContext?.();
+  if (!context) {
+    return { unavailableReason: "gateway context unavailable" };
+  }
+  try {
+    // Keep Enterprise policy out of the normal child-settle module graph. This
+    // branch runs only for a Personal Agent requester after registry restore.
+    const { projectEnterpriseBackgroundAgentContext } =
+      await import("../../../enterprise/isolation/enterprise-gateway-policy.js");
+    const projectedContext = projectEnterpriseBackgroundAgentContext({
+      context,
+      agentId: requesterAgentId,
+    });
+    if (!projectedContext) {
+      return {
+        unavailableReason: "Enterprise requester account or Agent entitlement unavailable",
+      };
+    }
+    return { resolveGatewayContext: () => projectedContext };
+  } catch {
+    // An unavailable projection is retryable while the Gateway is restoring;
+    // never fall back to the host roster for an Enterprise Personal Agent key.
+    return { unavailableReason: "Enterprise requester projection unavailable" };
+  }
+}
