@@ -0,0 +1,85 @@
+import { afterEach, describe, expect, it } from "vitest";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import { readGatewayRequestRuntimeMetadata } from "../../gateway/request-runtime-config.js";
+import type { GatewayRequestContext } from "../../gateway/server-methods/types.js";
+import { closeOpenClawStateDatabaseForTest } from "../../state/openclaw-state-db.js";
+import { withOpenClawTestState } from "../../test-utils/openclaw-test-state.js";
+import { createEnterpriseAccount, updateEnterpriseAccount } from "../accounts/account-store.js";
+import { hashEnterprisePassword } from "../auth/password.js";
+import { resolveEnterprisePersonalAgentId } from "../personal-agent/personal-agent-config.js";
+import { projectEnterpriseBackgroundAgentContext } from "./enterprise-gateway-policy.js";
+
+afterEach(() => {
+  closeOpenClawStateDatabaseForTest();
+});
+
+describe("Enterprise background requester projection", () => {
+  it("rebuilds the current personal projection without retaining a bearer session", async () => {
+    await withOpenClawTestState({ scenario: "minimal", applyEnv: true }, async (state) => {
+      const account = createEnterpriseAccount({
+        username: "background.recovery",
+        displayName: "Background Recovery",
+        passwordHash: await hashEnterprisePassword("enterprise-password"),
+        role: "employee",
+        mustChangePassword: false,
+      });
+      const config: OpenClawConfig = {
+        enterprise: { enabled: true, personalAgent: { templateAgentId: "main" } },
+        gateway: { auth: { mode: "accounts" } },
+        agents: { entries: { main: { workspace: state.workspaceDir } } },
+      };
+      const personalAgentId = resolveEnterprisePersonalAgentId(config, account);
+      const context = { getRuntimeConfig: () => config } as GatewayRequestContext;
+
+      const projected = projectEnterpriseBackgroundAgentContext({
+        context,
+        agentId: personalAgentId,
+      });
+
+      expect(projected).toBeDefined();
+      if (!projected) {
+        throw new Error("expected an account-owned Enterprise projection");
+      }
+      const projectedConfig = projected.getRuntimeConfig();
+      const metadata = readGatewayRequestRuntimeMetadata(projectedConfig);
+      expect(projected.resolveGatewayContext?.()).toBe(projected);
+      expect(projectedConfig.agents?.entries?.[personalAgentId]).toBeDefined();
+      expect(metadata?.enterpriseUser).toEqual({
+        accountId: account.id,
+        username: account.username,
+        displayName: account.displayName,
+        personalAgentId,
+        personalAgentTemplateId: "main",
+      });
+      expect(metadata?.enterpriseUser?.sessionId).toBeUndefined();
+      expect(metadata?.enterpriseDelegation?.accountId).toBe(account.id);
+    });
+  });
+
+  it("fails closed when the durable account projection is no longer usable", async () => {
+    await withOpenClawTestState({ scenario: "minimal", applyEnv: true }, async (state) => {
+      const account = createEnterpriseAccount({
+        username: "background.revoked",
+        displayName: "Background Revoked",
+        passwordHash: await hashEnterprisePassword("enterprise-password"),
+        role: "employee",
+        mustChangePassword: false,
+      });
+      const config: OpenClawConfig = {
+        enterprise: { enabled: true },
+        gateway: { auth: { mode: "accounts" } },
+        agents: { entries: { main: { workspace: state.workspaceDir } } },
+      };
+      const personalAgentId = resolveEnterprisePersonalAgentId(config, account);
+      const context = { getRuntimeConfig: () => config } as GatewayRequestContext;
+
+      expect(
+        projectEnterpriseBackgroundAgentContext({ context, agentId: personalAgentId }),
+      ).toBeDefined();
+      updateEnterpriseAccount(account.id, { enabled: false });
+      expect(
+        projectEnterpriseBackgroundAgentContext({ context, agentId: personalAgentId }),
+      ).toBeUndefined();
+    });
+  });
+});
