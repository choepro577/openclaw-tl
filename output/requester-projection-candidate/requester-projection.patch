+type EnterpriseUserRuntimeMetadataParams = {
+  config: OpenClawConfig;
+  context: GatewayRequestContext;
+  account: EnterpriseAccount;
+  personalAgentId: string;
+  delegationCandidates: readonly EnterpriseDelegationCandidate[];
+  /** Live portal sessions keep Knowledge and session auth checks enabled. */
+  enterpriseSessionId?: string;
+};
+
+function buildEnterpriseUserRuntimeMetadata(
+  params: EnterpriseUserRuntimeMetadataParams,
+): GatewayRequestRuntimeMetadata {
+  const knowledgeAuthorities = new Map<
+    string,
+    ReturnType<typeof createEnterpriseKnowledgeAuthority>
+  >();
+  const user = {
+    accountId: params.account.id,
+    ...(params.enterpriseSessionId ? { sessionId: params.enterpriseSessionId } : {}),
+    username: params.account.username,
+    displayName: params.account.displayName,
+    personalAgentId: params.personalAgentId,
+    personalAgentTemplateId: resolveEnterprisePersonalAgentTemplateId(
+      params.config,
+      params.account,
+    ),
+  };
+  const delegationCandidates = params.delegationCandidates.map((candidate) => ({
+    agentId: candidate.agentId,
+    name: candidate.name,
+    description: candidate.description,
+    assigned: candidate.assigned,
+    effective: candidate.effective,
+    routable: candidate.routable,
+    effectiveMode: candidate.effectiveMode,
+    reasonCodes: candidate.reasonCodes,
+    profileRevision: candidate.profileRevision,
+  }));
+  const currentAccount = () => {
+    const account = getEnterpriseAccountByProfileId(params.account.profileId);
+    if (!account?.enabled || account.mustChangePassword) {
+      return undefined;
+    }
+    if (params.enterpriseSessionId) {
+      const currentSession = getActiveEnterpriseSession(params.enterpriseSessionId, {}, "user");
+      if (!currentSession || currentSession.accountId !== account.id) {
+        return undefined;
+      }
+    }
+    return account;
+  };
+
+  const metadata: GatewayRequestRuntimeMetadata = {
+    // The background recovery path has no bearer session to validate. Account
+    // state and the current Agent entitlement remain authoritative for every
+    // use-time grant, matching the account-owned automation boundary.
+    nativePluginGrants: (agentId, harnessPluginId) => {
+      const account = currentAccount();
+      const normalizedAgentId = normalizeAgentId(agentId);
+      if (
+        harnessPluginId !== "codex" ||
+        !account ||
+        !resolveEnterpriseAllowedAgentIds(params.config, account, { userAudience: true }).has(
+          normalizedAgentId,
+        )
+      ) {
+        return [];
+      }
+      return listActiveEnterpriseCodexPluginGrants(account.id, normalizedAgentId);
+    },
+    enterpriseUser: user,
+    enterpriseCapabilities: {
+      resolve: (agentId) => {
+        const account = currentAccount();
+        if (!account) {
+          return {
+            allowed: false as const,
+            accountId: params.account.id,
+            agentId: normalizeAgentId(agentId),
+            reason: "account_disabled" as const,
+          };
+        }
+        return resolveEnterpriseSharedAgentCapabilities({
+          config: params.context.getRuntimeConfig(),
+          account,
+          agentId,
+        });
+      },
+    },
+    enterpriseDelegation: {
+      accountId: params.account.id,
+      personalAgentId: params.personalAgentId,
+      specialists: delegationCandidates,
+      resolveSpecialist: (agentId) => {
+        const account = currentAccount();
+        if (!account) {
+          return undefined;
+        }
+        const candidate = listEnterpriseDelegationCandidates(
+          params.context.getRuntimeConfig(),
+          account,
+        ).find((item) => normalizeAgentId(item.agentId) === normalizeAgentId(agentId));
+        return candidate
+          ? {
+              agentId: candidate.agentId,
+              name: candidate.name,
+              description: candidate.description,
+              assigned: candidate.assigned,
+              effective: candidate.effective,
+              routable: candidate.routable,
+              effectiveMode: candidate.effectiveMode,
+              reasonCodes: candidate.reasonCodes,
+              profileRevision: candidate.profileRevision,
+            }
+          : undefined;
+      },
+      resolveExplicitAgentIds: (prompt) =>
+        explicitlyMentionedEnterpriseAgentIds(params.config, prompt),
+    },
+  };
+
+  // Knowledge authority is deliberately only restored for a live portal
+  // session. Its contract requires the raw session bearer and must never be
+  // reconstructed from the hashed database row after a process restart.
+  if (params.enterpriseSessionId) {
+    metadata.enterpriseKnowledge = {
+      createAuthority(agentId: string) {
+        const normalizedAgentId = normalizeAgentId(agentId);
+        const normalizedPersonalAgentId = normalizeAgentId(params.personalAgentId);
+        const agentResourceKey =
+          normalizedAgentId === normalizedPersonalAgentId
+            ? personalAgentResourceKey(params.account.id)
+            : sharedAgentResourceKey(normalizedAgentId);
+        let authority = knowledgeAuthorities.get(agentResourceKey);
+        if (!authority) {
+          authority = createEnterpriseKnowledgeAuthority({
+            accountId: params.account.id,
+            sessionId: params.enterpriseSessionId!,
+            agentResourceKey,
+            config: params.config,
+          });
+          knowledgeAuthorities.set(agentResourceKey, authority);
+        }
+        return authority;
+      },
+    };
+  }
+  return metadata;
+}
+
+/**
+ * Rebuilds the account-owned Enterprise projection used by durable completion
+ * delivery after a Gateway restart. The resolver itself is process-local, so
+ * only the non-secret account identity is recovered from the deterministic
+ * Personal Agent id; the current account and entitlement are checked again.
+ */
+export function projectEnterpriseBackgroundAgentContext(params: {
+  context: GatewayRequestContext;
+  agentId: string;
+}): GatewayRequestContext | undefined {
+  const config = params.context.getRuntimeConfig();
+  if (!isEnterpriseEnabled(config) || config.gateway?.auth?.mode !== "accounts") {
+    return undefined;
+  }
+  const agentId = normalizeAgentId(params.agentId);
+  const account = listEnterpriseAccounts().find(
+    (candidate) =>
+      candidate.enabled &&
+      !candidate.mustChangePassword &&
+      candidate.personalAgentEnabled &&
+      normalizeAgentId(resolveEnterprisePersonalAgentId(config, candidate)) === agentId,
+  );
+  if (!account) {
+    return undefined;
+  }
+  const allowedAgents = resolveEnterpriseAllowedAgentIds(config, account, { userAudience: true });
+  if (!allowedAgents.has(agentId)) {
+    return undefined;
+  }
+  const personalAgentId = resolveEnterprisePersonalAgentId(config, account);
+  const delegationCandidates = listEnterpriseDelegationCandidates(config, account);
+  const projectedConfig = projectEnterpriseRuntimeConfig(config, account, {
+    userAudience: true,
+    delegationCandidates,
+  });
+  return contextWithConfig(
+    params.context,
+    markGatewayRequestScopedRuntimeConfig(
+      projectedConfig,
+      buildEnterpriseUserRuntimeMetadata({
+        config,
+        context: params.context,
+        account,
+        personalAgentId,
+        delegationCandidates,
+      }),
+    ),
+  );
+}
